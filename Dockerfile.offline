# =============================================================================
# CaaS 构建分两步：
#   Step 1: cd web && bun install && bun run build
#   Step 2: docker build -f Dockerfile.offline .
# =============================================================================

# ── Stage 1: Go 后端编译 ─────────────────────────────────────────────────────
FROM golang:1.26.1-alpine AS builder

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOWORK=off \
    GOEXPERIMENT=greenteagc \
    GOPROXY=https://goproxy.cn,https://mirrors.aliyun.com/goproxy/,https://goproxy.io,direct

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}

WORKDIR /build

# go.mod/go.sum 单独一层，不变时走缓存，跳过依赖下载
ADD go.mod go.sum ./
ADD relaykit/go.mod ./relaykit/go.mod
RUN go mod download

COPY . .
COPY /web/dist ./web/dist
RUN go build \
    -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" \
    -o new-api

# ── Stage 2: 运行环境 ────────────────────────────────────────────────────────
FROM debian:bookworm-slim

COPY --from=builder /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/

EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]